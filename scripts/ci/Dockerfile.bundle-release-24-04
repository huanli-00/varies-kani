# Docker image for Kani GitHub Package release ubuntu-24-04.

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true \
    PATH="/root/.cargo/bin:${PATH}"
WORKDIR /tmp/kani
COPY ./varies-kani-*-x86_64-unknown-linux-gnu.tar.gz ./varies-kani-latest-x86_64-unknown-linux-gnu.tar.gz
# Very awkward glob (not regex!) to get `varies-kani-verifier-*` and not `varies-kani-verifier-*.crate`
COPY ./target/package/varies-kani-verifier-*[^e] ./varies-kani-verifier

# Install Kani and dependencies. We will install the required
# toolchain by running an empty cargo command inside kani release
# directory. Rustup is purged for space.

RUN apt-get update && \
    apt-get install -y curl build-essential && \
    curl -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none && \
    (cd varies-kani-verifier/; cargo) && \
    rustup default $(rustup toolchain list | awk '{ print $1 }') && \
    cargo install --path ./varies-kani-verifier && \
    cargo-varies-kani setup --use-local-bundle ./varies-kani-latest-x86_64-unknown-linux-gnu.tar.gz && \
    apt-get clean && \
    rm -rf /tmp/kani/* /root/.rustup/toolchains/*/share
