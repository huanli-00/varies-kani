# Note: this file is intended only for testing the kani release bundle

FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true
RUN apt-get update && \
    apt-get install -y curl build-essential && \
    curl -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /tmp/kani
COPY ./tests ./tests
COPY ./varies-kani-latest-*.tar.gz ./
# Very awkward glob (not regex!) to get `varies-kani-verifier-*` and not `varies-kani-verifier-*.crate`
COPY ./target/package/varies-kani-verifier-*[^e] ./varies-kani-verifier
RUN cargo install --path ./varies-kani-verifier
RUN cargo-varies-kani setup --use-local-bundle ./varies-kani-latest-*.tar.gz
